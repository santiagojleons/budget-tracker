<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Budget Tracker</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root{
  --bg:#0a0d14;
  --sidebar:#0f1320;
  --panel:#141929;
  --soft:#1a2035;
  --border:#1f2d45;
  --border2:#263350;
  --text:#e8edf5;
  --muted:#6b7a99;
  --muted2:#8a96b0;
  --green:#22c77a;
  --gdark:#16a362;
  --glow:rgba(34,199,122,0.15);
  --warn:#f59e0b;
  --red:#ef4444;
  --blue:#3b82f6;
  --purple:#8b5cf6;
  --accent:#1e3a5f;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Inter',Arial,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}

/* ── LAYOUT ── */
.shell{display:grid;grid-template-columns:280px 1fr;min-height:100vh;}
.side{background:var(--sidebar);border-right:1px solid var(--border);padding:24px 16px;display:flex;flex-direction:column;gap:6px;overflow-y:auto;}
.main{padding:24px;display:flex;flex-direction:column;gap:20px;overflow-y:auto;background:var(--bg);}

/* ── SIDEBAR ── */
.side-logo{padding:8px 12px 20px;display:flex;align-items:center;gap:10px;}
.side-logo h1{font-size:1.05rem;font-weight:800;color:#22c77a;letter-spacing:-.01em;}
.side-section-label{font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;padding:16px 12px 6px;}
.side-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;font-size:.88rem;color:var(--muted2);cursor:pointer;transition:all .15s;border:none;background:transparent;width:100%;text-align:left;}
.side-item:hover{background:var(--soft);color:var(--text);}
.side-item.active{background:var(--glow);color:var(--green);font-weight:600;}
.side-item svg{flex-shrink:0;opacity:0.7;}
.side-item.active svg, .side-item:hover svg{opacity:1;}
.side-divider{height:1px;background:var(--border);margin:8px 0;}

/* ── MONTH TABS ── */
.month-tabs{display:flex;flex-wrap:wrap;gap:6px;padding:4px 0;}
.mtab{padding:6px 12px;border-radius:8px;border:1px solid var(--border2);background:transparent;color:var(--muted);font-size:.8rem;cursor:pointer;transition:all .15s;font-family:'Inter',sans-serif;}
.mtab:hover{border-color:var(--green);color:var(--green);}
.mtab.active{background:var(--glow);border-color:var(--green);color:var(--green);font-weight:700;}

/* ── CARDS ── */
.card{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:20px;}
.card-title{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:16px;font-weight:600;}

/* ── STAT CARDS ── */
.stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;}
.stat-card{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:18px 20px;}
.stat-label{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;}
.stat-val{font-size:1.6rem;font-weight:800;line-height:1;}
.stat-val.green{color:var(--green);}
.stat-val.red{color:var(--red);}
.stat-val.warn{color:var(--warn);}
.stat-sub{font-size:.75rem;color:var(--muted);margin-top:6px;}

/* ── INPUTS ── */
.inp{display:block;width:100%;background:var(--soft);border:1px solid var(--border2);border-radius:10px;color:var(--text);padding:10px 14px;font-size:.9rem;outline:none;font-family:'Inter',sans-serif;transition:border-color .15s;}
.inp:focus{border-color:var(--green);box-shadow:0 0 0 3px var(--glow);}
.sel{display:block;width:100%;background:var(--soft);border:1px solid var(--border2);border-radius:10px;color:var(--text);padding:10px 14px;font-size:.88rem;outline:none;font-family:'Inter',sans-serif;cursor:pointer;transition:border-color .15s;}
.sel:focus{border-color:var(--green);box-shadow:0 0 0 3px var(--glow);}

/* ── DATE INPUT FIX ── */
input[type="date"]{color-scheme:dark;background:var(--soft);border:1px solid var(--border2);border-radius:10px;color:var(--text);padding:10px 14px;font-size:.9rem;outline:none;font-family:'Inter',sans-serif;cursor:pointer;width:100%;transition:border-color .15s;}
input[type="date"]:focus{border-color:var(--green);box-shadow:0 0 0 3px var(--glow);}
input[type="date"]::-webkit-calendar-picker-indicator{filter:invert(0.8) sepia(1) saturate(3) hue-rotate(100deg);cursor:pointer;padding:2px;}
input[type="date"]::-webkit-datetime-edit{color:var(--text);}
input[type="date"]::-webkit-datetime-edit-fields-wrapper{color:var(--text);}

/* ── BUTTONS ── */
.gbtn{display:block;width:100%;padding:11px 16px;border:none;border-radius:10px;background:linear-gradient(135deg,#22c77a,#16a362);color:#03120a;font-size:.9rem;font-weight:700;cursor:pointer;margin-top:10px;font-family:'Inter',sans-serif;transition:filter .15s, transform .1s;}
.gbtn:hover{filter:brightness(1.1);transform:translateY(-1px);}
.gbtn:active{transform:translateY(0);}
.gbtn.sm{padding:7px 12px;font-size:.8rem;width:auto;margin-top:0;}
.gbtn.ghost{background:transparent;border:1px solid var(--border2);color:var(--muted2);font-weight:500;}
.gbtn.ghost:hover{border-color:var(--green);color:var(--green);filter:none;transform:none;}
.gbtn.danger{background:rgba(239,68,68,.12);color:#fca5a5;border:1px solid rgba(239,68,68,.2);}
.gbtn.danger:hover{background:rgba(239,68,68,.25);filter:none;}
.helper{font-size:.74rem;color:var(--muted);margin-top:8px;line-height:1.6;}

/* ── OVERVIEW ROWS ── */
.brow{display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid var(--border);}
.brow:last-child{border-bottom:none;}
.bname{font-weight:600;font-size:.88rem;}
.bpct{font-size:.68rem;color:var(--green);background:var(--glow);border-radius:999px;padding:2px 8px;margin-left:6px;border:1px solid rgba(34,199,122,.2);}
.blbl{color:var(--muted);font-size:.72rem;margin-top:2px;}

/* ── GRID ── */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;}
.ccard{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:18px;transition:border-color .2s;}
.ccard:hover{border-color:var(--border2);}
.chead{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}
.chead h3{font-size:.92rem;font-weight:700;}
.badge{background:var(--glow);color:var(--green);border:1px solid rgba(34,199,122,.25);padding:3px 10px;border-radius:999px;font-size:.72rem;font-weight:700;}
.row{display:flex;justify-content:space-between;font-size:.83rem;padding:3px 0;}
.row span{color:var(--muted);}
.prog-wrap{background:var(--border);border-radius:999px;height:5px;margin:8px 0 12px;}
.prog-bar{height:5px;border-radius:999px;background:linear-gradient(90deg,var(--green),var(--gdark));transition:width .4s;max-width:100%;}
.prog-bar.over{background:linear-gradient(90deg,var(--warn),var(--red));}
.cat-target-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
.cat-target-label{font-size:.73rem;color:var(--muted);}
.cat-target-amt{font-size:.73rem;font-weight:700;}
.cat-target-amt.ok{color:var(--green);}
.cat-target-amt.over{color:var(--red);}

/* ── SUBCATEGORY ── */
.scard{background:var(--soft);border:1px solid var(--border);border-radius:12px;padding:12px;margin-top:10px;transition:border-color .15s;}
.scard:hover{border-color:var(--border2);}
.scard-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;gap:6px;}
.name-inp{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:8px;color:var(--text);padding:6px 10px;font-size:.82rem;font-weight:600;outline:none;min-width:0;font-family:'Inter',sans-serif;}
.name-inp:focus{border-color:var(--green);}
.spct-badge{font-size:.64rem;color:var(--muted);background:rgba(148,163,184,.08);border-radius:999px;padding:2px 8px;white-space:nowrap;border:1px solid var(--border);}
.budget-inp{display:block;width:100%;background:var(--bg);border:1px solid var(--border);border-radius:9px;color:var(--text);padding:8px 10px;font-size:.85rem;margin-bottom:6px;outline:none;font-family:'Inter',sans-serif;}
.budget-inp:focus{border-color:var(--green);}
.add-sub-row{display:flex;gap:8px;margin-top:10px;align-items:center;}
.add-sub-inp{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:9px;color:var(--text);padding:8px 10px;font-size:.82rem;outline:none;font-family:'Inter',sans-serif;}
.add-sub-inp:focus{border-color:var(--green);}

/* ── EXPENSE FORM ── */
.eform{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-items:end;}
.fg label{display:block;font-size:.76rem;color:var(--muted);margin-bottom:5px;font-weight:500;}

/* ── TABLE ── */
table{width:100%;border-collapse:collapse;}
th,td{padding:12px 12px;border-bottom:1px solid var(--border);text-align:left;font-size:.85rem;}
th{color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;font-weight:600;}
tbody tr{transition:background .1s;}
tbody tr:hover{background:var(--soft);}
tbody tr:last-child td{border-bottom:none;}
.empty{text-align:center;color:var(--muted);padding:32px 0!important;}
.good{color:var(--green);}
.bad{color:var(--warn);}
.action-btns{display:flex;gap:6px;}
.xbtn{background:rgba(239,68,68,.1);color:#fca5a5;border:1px solid rgba(239,68,68,.15);border-radius:8px;padding:5px 10px;font-size:.78rem;cursor:pointer;transition:background .15s;}
.xbtn:hover{background:rgba(239,68,68,.25);}
.ebtn{background:rgba(34,199,122,.08);color:var(--green);border:1px solid rgba(34,199,122,.15);border-radius:8px;padding:5px 10px;font-size:.78rem;cursor:pointer;transition:background .15s;}
.ebtn:hover{background:rgba(34,199,122,.2);}

/* ── UNALLOCATED ── */
.unalloc-box{border-radius:12px;padding:14px 16px;margin-top:4px;}
.unalloc-box.ok{background:rgba(34,199,122,.07);border:1px solid rgba(34,199,122,.18);}
.unalloc-box.over{background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.2);}
.unalloc-label{font-size:.72rem;color:var(--muted);margin-bottom:4px;font-weight:500;}
.unalloc-amt{font-size:1.4rem;font-weight:800;}
.unalloc-amt.ok{color:var(--green);}
.unalloc-amt.over{color:var(--red);}
.unalloc-hint{font-size:.71rem;color:var(--muted);margin-top:4px;line-height:1.5;}

/* ── MODAL ── */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:100;align-items:center;justify-content:center;backdrop-filter:blur(4px);}
.modal-bg.open{display:flex;}
.modal{background:var(--panel);border:1px solid var(--border2);border-radius:20px;padding:28px;width:100%;max-width:440px;display:flex;flex-direction:column;gap:16px;box-shadow:0 25px 60px rgba(0,0,0,.5);}
.modal h3{font-size:1rem;font-weight:700;margin-bottom:2px;}
.modal label{display:block;font-size:.78rem;color:var(--muted);margin-bottom:5px;font-weight:500;}
.modal input,.modal select{display:block;width:100%;background:var(--soft);border:1px solid var(--border2);border-radius:10px;color:var(--text);padding:10px 14px;font-size:.9rem;outline:none;font-family:'Inter',sans-serif;}
.modal input:focus,.modal select:focus{border-color:var(--green);box-shadow:0 0 0 3px var(--glow);}
.modal input[type="date"]{color-scheme:dark;}
.modal-btns{display:flex;gap:10px;margin-top:4px;}
.modal-btns button{flex:1;padding:11px;border:none;border-radius:10px;font-size:.92rem;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;transition:filter .15s;}
.modal-btns .save{background:linear-gradient(135deg,#22c77a,#16a362);color:#03120a;}
.modal-btns .save:hover{filter:brightness(1.1);}
.modal-btns .cancel{background:var(--soft);color:var(--muted2);border:1px solid var(--border2);}
.modal-btns .cancel:hover{color:var(--text);}


/* ── TABS ── */
.tab-panel{display:flex;flex-direction:column;gap:20px;}
.tab-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;}
.tab-title{font-size:1.4rem;font-weight:800;color:var(--text);transition:color .2s;}
.tab-sub{font-size:.82rem;color:var(--muted);margin-top:4px;}
/* ── AUTH SCREEN ── */
#authScreen{background:var(--bg);}
.auth-card{background:var(--panel);border:1px solid var(--border2);border-radius:20px;padding:36px 32px;width:100%;max-width:380px;display:flex;flex-direction:column;gap:14px;box-shadow:0 20px 60px rgba(0,0,0,.4);}
.auth-logo{font-size:1.15rem;font-weight:800;color:#22c77a;text-align:center;margin-bottom:4px;letter-spacing:-.01em;}
.auth-sub{font-size:.82rem;color:var(--muted);text-align:center;margin-bottom:8px;}

@media(max-width:860px){
  .shell{grid-template-columns:1fr;}
  .side{border-right:none;border-bottom:1px solid var(--border);padding:16px;}
  .stat-row{grid-template-columns:repeat(2,1fr);}
}
</style>
</head>
<body>


<div class="modal-bg" id="nicknameModal">
  <div class="modal" style="max-width:380px;text-align:center;align-items:center;">
    <svg width="48" height="48" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-bottom:4px">
      <rect width="32" height="32" rx="10" fill="rgba(34,199,122,0.12)"/>
      <polyline points="5,23 11,15 16,18 22,10 27,10" stroke="#22c77a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="27" cy="10" r="2" fill="#22c77a"/>
      <line x1="5" y1="26" x2="27" y2="26" stroke="#22c77a" stroke-width="1.5" stroke-linecap="round" opacity="0.3"/>
    </svg>
    <h3 style="font-size:1.2rem;">Welcome to Budget Tracker!</h3>
    <p style="font-size:.85rem;color:var(--muted);margin-top:-6px;line-height:1.6;">Let's personalize your experience.<br/>What should we call you?</p>
    <div style="width:100%">
      <input id="nicknameInp" class="inp" type="text" placeholder="Your first name or nickname" maxlength="30" style="text-align:center;font-size:1rem;" onkeydown="if(event.key==='Enter')saveNickname()"/>
    </div>
    <button class="gbtn" style="margin-top:0;max-width:220px" onclick="saveNickname()">Let's go →</button>
  </div>
</div>

<div class="modal-bg" id="editModal">
  <div class="modal">
    <h3>Edit Transaction</h3>
    <div><label>Name</label><input id="mName" type="text"/></div>
    <div><label>Category</label><select id="mCat" onchange="mSyncSubs()"></select></div>
    <div><label>Subcategory</label><select id="mSub"></select></div>
    <div><label>Amount ($)</label><input id="mAmt" type="number" min="0" step="0.01"/></div>
    <div><label>Date</label><input id="mDate" type="date"/></div>
    <div class="modal-btns">
      <button class="save" onclick="saveEdit()">Save</button>
      <button class="cancel" onclick="closeModal()">Cancel</button>
    </div>
  </div>
</div>

<div id="authScreen" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;">
  <div class="auth-card">
    <div class="auth-logo" style="display:flex;align-items:center;justify-content:center;gap:10px;">
      <svg width="36" height="36" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" rx="10" fill="rgba(34,199,122,0.12)"/>
        <polyline points="5,23 11,15 16,18 22,10 27,10" stroke="#22c77a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="27" cy="10" r="2" fill="#22c77a"/>
        <line x1="5" y1="26" x2="27" y2="26" stroke="#22c77a" stroke-width="1.5" stroke-linecap="round" opacity="0.3"/>
      </svg>
      Budget Tracker
    </div>
    <p class="auth-sub">Track your money. Reach your goals.</p>
    <div><label style="display:block;font-size:.78rem;color:var(--muted);margin-bottom:5px;">Email</label><input id="authEmail" class="inp" type="email" placeholder="you@email.com"/></div>
    <div><label style="display:block;font-size:.78rem;color:var(--muted);margin-bottom:5px;">Password</label><input id="authPass" class="inp" type="password" placeholder="••••••••"/></div>
    <button class="gbtn" style="margin-top:4px" onclick="doLogin()">Log In</button>
    <button class="gbtn ghost" style="margin-top:6px" onclick="doSignup()">Create Account</button>
    <p id="authMsg" style="color:#f87171;font-size:.78rem;text-align:center;min-height:18px;"></p>
  </div>
</div>
<div class="shell" style="display:none;">
  <aside class="side">
    <div class="side-logo">
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" rx="10" fill="rgba(34,199,122,0.12)"/>
        <polyline points="5,23 11,15 16,18 22,10 27,10" stroke="#22c77a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="27" cy="10" r="2" fill="#22c77a"/>
        <line x1="5" y1="26" x2="27" y2="26" stroke="#22c77a" stroke-width="1.5" stroke-linecap="round" opacity="0.3"/>
      </svg>
      <h1>Budget Tracker</h1>
    </div>

    <div class="side-divider"></div>
    <div class="side-section-label">Menu</div>

    <button class="side-item active" id="nav-dashboard" onclick="switchTab('dashboard')">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg> Dashboard
    </button>
    <button class="side-item" id="nav-transactions" onclick="switchTab('transactions')">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg> Transactions
    </button>
    <button class="side-item" id="nav-categories" onclick="switchTab('categories')">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg> Categories
    </button>
    <button class="side-item" id="nav-income" onclick="switchTab('income')">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg> Income & Budget
    </button>

    <div class="side-divider"></div>
    <div class="side-section-label">Period</div>
    <div style="padding:0 4px">
      <div class="month-tabs" id="monthTabs"></div>
      <button class="gbtn ghost sm" style="margin-top:8px;width:100%" onclick="addMonth()">+ New Month</button>
    </div>

    <div class="side-divider" style="margin-top:auto"></div>
    <button class="side-item" onclick="doLogout()" style="margin-top:8px">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg> Log Out
    </button>
  </aside>

  <main class="main">

    <div id="tab-dashboard" class="tab-panel">
      <div class="tab-header">
        <div>
          <h2 class="tab-title" id="dashWelcome">Dashboard</h2>
          <p class="tab-sub" id="dashMonthLabel"></p>
        </div>
      </div>
      <div class="stat-row" id="statRow"></div>
      <div class="grid" id="catGrid"></div>
    </div>

    <div id="tab-transactions" class="tab-panel" style="display:none">
      <div class="tab-header">
        <div>
          <h2 class="tab-title">Transactions</h2>
          <p class="tab-sub">All recorded expenses for this month</p>
        </div>
        <button class="gbtn sm" style="margin-top:0" onclick="switchTab('add-expense')">+ Add Expense</button>
      </div>
      <div class="card">
        <div style="overflow-x:auto">
          <table>
            <thead><tr><th>Name</th><th>Category</th><th>Subcategory</th><th>Date</th><th>Amount</th><th></th></tr></thead>
            <tbody id="txBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="tab-add-expense" class="tab-panel" style="display:none">
      <div class="tab-header">
        <div>
          <h2 class="tab-title">Add Expense</h2>
          <p class="tab-sub">Log a new transaction</p>
        </div>
      </div>
      <div class="card" style="max-width:680px">
        <div class="eform">
          <div class="fg"><label>Name</label><input class="inp" id="eName" type="text" placeholder="Rent, Netflix..."/></div>
          <div class="fg"><label>Category</label><select class="sel" id="eCat" onchange="syncSubs()"></select></div>
          <div class="fg"><label>Subcategory</label><select class="sel" id="eSub"></select></div>
          <div class="fg"><label>Amount ($)</label><input class="inp" id="eAmt" type="number" min="0" step="0.01" placeholder="0.00"/></div>
          <div class="fg"><label>Date</label><input id="eDate" type="date"/></div>
          <div class="fg"><label>&nbsp;</label><button class="gbtn" style="margin-top:0" onclick="addExpense()">Add Expense</button></div>
        </div>
      </div>
    </div>

    <div id="tab-categories" class="tab-panel" style="display:none">
      <div class="tab-header">
        <div>
          <h2 class="tab-title">Categories</h2>
          <p class="tab-sub">Manage your budget categories and subcategories</p>
        </div>
      </div>
      <div class="grid" id="catGridFull"></div>
    </div>

    <div id="tab-income" class="tab-panel" style="display:none">
      <div class="tab-header">
        <div>
          <h2 class="tab-title">Income & Budget</h2>
          <p class="tab-sub">Set your monthly income and category targets</p>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;max-width:860px">
        <div class="card">
          <div class="card-title">Monthly Net Income</div>
          <label style="display:block;font-size:.76rem;color:var(--muted);margin-bottom:6px;">Enter your take-home pay</label>
          <input class="inp" id="incIn" type="number" min="0" step="0.01" placeholder="e.g. 4000" onchange="saveAndRender()"/>
          <button class="gbtn" onclick="applyTargets()" style="margin-top:10px">Apply Budget Targets</button>
          <p class="helper">Automatically sets category pools using the 50/15/25/10 rule. Subcategory amounts start at $0 for you to assign.</p>
        </div>
        <div class="card">
          <div class="card-title">Allocation Overview</div>
          <div id="overview"></div>
          <div id="unallocBox" style="margin-top:10px"></div>
        </div>
      </div>
    </div>

  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const { createClient } = supabase;
const sb = createClient(
  'https://mmlwddyksjsxzsuohhwc.supabase.co',   // 👈 Replace with your Supabase Project URL
  'sb_publishable_jf1ycwxyiHLHDyNGi6OTMQ_aNHZAw6L'       // 👈 Replace with your anon/public key
);
let currentUser = null;

// ── MONTHS LIST ────────────────────────────────────────────────────────────
var MONTH_NAMES = ["January","February","March","April","May","June","July","August","September","October","November","December"];

function defaultBD(){
  // Empty subcategories on first setup — user builds their own
  return [
    {name:"Essentials",pct:0.50,pool:0,subs:[]},
    {name:"Growth",pct:0.15,pool:0,subs:[]},
    {name:"Lifestyle",pct:0.25,pool:0,subs:[]},
    {name:"Savings",pct:0.10,pool:0,subs:[]}
  ];
}

// STATE
var STATE; // loaded from localStorage or initialised fresh

function initState(){
  var now = new Date();
  var key = MONTH_NAMES[now.getMonth()]+" "+now.getFullYear();
  return {
    activeMonth: key,
    months: {}
  };
}

function ensureMonth(key, copyBudgetsFrom){
  if(!STATE.months[key]){
    // Auto-carry over structure from previous month if one exists, else use defaults
    var allKeys = Object.keys(STATE.months);
    var autoSource = copyBudgetsFrom || (allKeys.length > 0 ? STATE.months[allKeys[allKeys.length-1]].bd : null);
    var bd = autoSource ? JSON.parse(JSON.stringify(autoSource)) : defaultBD();
    // Reset spent amounts and pools — keep names and budgets
    for(var c=0;c<bd.length;c++){
      bd[c].pool=0;
      for(var s=0;s<bd[c].subs.length;s++) bd[c].subs[s].spent=0;
    }
    STATE.months[key]={income:0, bd: bd, txs:[]};
  }
}

function activeData(){ return STATE.months[STATE.activeMonth]; }

async function saveState(){
  if(!currentUser) return;
  await sb.from('user_states').upsert({
    user_id: currentUser.id,
    state: STATE,
    updated_at: new Date()
  }, { onConflict: 'user_id' });
}

async function loadState(){
  if(!currentUser) return;
  const { data } = await sb.from('user_states')
    .select('state')
    .eq('user_id', currentUser.id)
    .single();
  if(data){
    STATE = data.state;
  } else {
    STATE = initState();
    ensureMonth(STATE.activeMonth, null);
  }
}

// ── HELPERS ────────────────────────────────────────────────────────────────
function $id(id){ return document.getElementById(id); }
function money(n){ var v=parseFloat(n)||0; return "$"+v.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,","); }
function getIncome(){ return Math.round((parseFloat($id("incIn").value)||0)*100)/100; }

// --- CORRECTED MATH LOGIC: totalAssigned ---
function totalAssigned(bd){
  var t = 0;
  for(var c=0; c < bd.length; c++) {
    for(var s=0; s < bd[c].subs.length; s++) {
      t += (parseFloat(bd[c].subs[s].budget) || 0);
    }
  }
  return Math.round(t*100)/100;
}

// ── MONTH MANAGEMENT ───────────────────────────────────────────────────────
function addMonth(){
  var now = new Date();
  var suggestions = [];
  for(var i=0;i<12;i++){
    var d = new Date(now.getFullYear(), now.getMonth()+i, 1);
    var k = MONTH_NAMES[d.getMonth()]+" "+d.getFullYear();
    if(!STATE.months[k]) suggestions.push(k);
  }
  var label = suggestions.length ? suggestions[0] : "";
  var input = prompt("New month name:", label);
  if(!input || !input.trim()) return;
  var key = input.trim();
  // Automatically carry over subcategory structure from current month (reset spent)
  ensureMonth(key, activeData().bd);
  STATE.activeMonth = key;
  saveState();
  renderMonthTabs();
  loadMonthIntoUI();
  
  if(typeof render === 'function') render();
}

function switchMonth(key){
  // Save current income before switching
  var d = activeData();
  d.income = getIncome();
  saveState();
  STATE.activeMonth = key;
  saveState();
  loadMonthIntoUI();
  
  if(typeof render === 'function') render();
}

function loadMonthIntoUI(){
  var d = activeData();
  $id("incIn").value = d.income || "";
  syncCatDropdown();
}

function renderMonthTabs(){
  var keys = Object.keys(STATE.months);
  var html = "";
  for(var i=0;i<keys.length;i++){
    var k=keys[i];
    html += '<button class="mtab'+(k===STATE.activeMonth?' active':'')+'" onclick="switchMonth(\''+k.replace(/'/g,"\\'")+'\')">' + k + '</button>';
  }
  $id("monthTabs").innerHTML = html;
}

// ── INCOME ────────────────────────────────────────────────────────────────
function applyTargets(){
  var income = getIncome();
  if(!income||income<=0){ alert("Enter a valid monthly income first."); return; }
  var d = activeData();
  d.income = income;
  for(var c=0;c<d.bd.length;c++){
    d.bd[c].pool = Math.round(income*d.bd[c].pct*100)/100;
    for(var s=0;s<d.bd[c].subs.length;s++) d.bd[c].subs[s].budget=0;
  }
  if (typeof saveAndRender === 'function') saveAndRender();
}

// ── SUBCATEGORY MANAGEMENT ─────────────────────────────────────────────────

// --- CORRECTED MATH LOGIC: setBudget ---
function setBudget(ci,si,val){
  var income = getIncome();
  var d = activeData();
  var v = parseFloat(val); 
  if(isNaN(v) || v < 0) v = 0;
  v = Math.round(v * 100) / 100;
  
  if(income > 0){
    // Temporarily set this specific subcategory to 0 so we can see what is budgeted everywhere else
    var tempBudget = d.bd[ci].subs[si].budget;
    d.bd[ci].subs[si].budget = 0;
    
    // Math: Monthly Income - Total Budgeted
    var otherAssigned = totalAssigned(d.bd);
    var max = Math.round((income - otherAssigned) * 100) / 100;
    
    // Cap the input if it exceeds the remaining unallocated income
    if(v > max){ 
      v = max < 0 ? 0 : max; 
      alert("Capped at " + money(v) + " — only " + money(max) + " of unallocated income remains."); 
    }
  }
  
  // Set the validated value
  d.bd[ci].subs[si].budget = v;
  if (typeof saveAndRender === 'function') saveAndRender();
}

function setSubName(ci,si,val){
  var d=activeData();
  d.bd[ci].subs[si].name=val.trim()||"Subcategory";
  saveState();
  syncCatDropdown();
}

function addSub(ci){
  var inp=$id("newSubName-"+ci);
  var name=inp.value.trim();
  if(!name){ alert("Enter a subcategory name."); return; }
  activeData().bd[ci].subs.push({name:name,budget:0,spent:0});
  inp.value="";
  if (typeof saveAndRender === 'function') saveAndRender();
}

function deleteSub(ci,si){
  var d=activeData();
  var sub=d.bd[ci].subs[si];
  if(sub.spent>0){ if(!confirm("This subcategory has $"+sub.spent.toFixed(2)+" in recorded spending. Delete anyway?")) return; }
  else if(!confirm("Delete subcategory \""+sub.name+"\"?")) return;
  d.bd[ci].subs.splice(si,1);
  // fix transaction refs
  for(var i=0;i<d.txs.length;i++){
    if(d.txs[i].ci===ci&&d.txs[i].si===si){ d.txs[i].si=-1; }
    else if(d.txs[i].ci===ci&&d.txs[i].si>si){ d.txs[i].si--; }
  }
  if (typeof saveAndRender === 'function') saveAndRender();
}

// ── TRANSACTIONS ──────────────────────────────────────────────────────────
function syncSubs(){
  var ci=parseInt($id("eCat").value,10);
  var d=activeData();
  var html="";
  for(var i=0;i<d.bd[ci].subs.length;i++) html+='<option value="'+i+'">'+d.bd[ci].subs[i].name+'</option>';
  $id("eSub").innerHTML=html;
}

function syncCatDropdown(){
  var d=activeData();
  var prev=parseInt($id("eCat").value,10)||0;
  var html="";
  for(var i=0;i<d.bd.length;i++) html+='<option value="'+i+'">'+d.bd[i].name+'</option>';
  $id("eCat").innerHTML=html;
  $id("eCat").value=Math.min(prev,d.bd.length-1);
  syncSubs();
}

function addExpense(){
  var d=activeData();
  var name=$id("eName").value.trim();
  var ci=parseInt($id("eCat").value,10);
  var si=parseInt($id("eSub").value,10);
  var amt=parseFloat($id("eAmt").value);
  var date=$id("eDate").value;
  if(!name||isNaN(amt)||amt<=0||!date){ alert("Fill in name, amount and date."); return; }
  d.bd[ci].subs[si].spent=Math.round((d.bd[ci].subs[si].spent+amt)*100)/100;
  d.txs.push({id:Date.now()+""+Math.random(),name:name,cat:d.bd[ci].name,sub:d.bd[ci].subs[si].name,ci:ci,si:si,amt:Math.round(amt*100)/100,date:date});
  $id("eName").value=$id("eAmt").value=$id("eDate").value="";
  if (typeof saveAndRender === 'function') saveAndRender();
}

function deleteTx(id){
  var d=activeData();
  var idx=-1; for(var i=0;i<d.txs.length;i++){ if(d.txs[i].id===id){idx=i;break;} }
  if(idx<0) return;
  var tx=d.txs[idx];
  if(!confirm('Delete "'+tx.name+'" for '+money(tx.amt)+'?')) return;
  if(tx.si>=0) d.bd[tx.ci].subs[tx.si].spent=Math.round(Math.max(0,d.bd[tx.ci].subs[tx.si].spent-tx.amt)*100)/100;
  d.txs.splice(idx,1);
  if (typeof saveAndRender === 'function') saveAndRender();
}

// ── EDIT MODAL ────────────────────────────────────────────────────────────
var EDIT_ID = null;

function openEdit(id){
  var d=activeData();
  var tx=null; for(var i=0;i<d.txs.length;i++) if(d.txs[i].id===id){ tx=d.txs[i]; break; }
  if(!tx) return;
  EDIT_ID=id;
  var html=""; for(var i=0;i<d.bd.length;i++) html+='<option value="'+i+'">'+d.bd[i].name+'</option>';
  $id("mCat").innerHTML=html;
  $id("mCat").value=tx.ci;
  mSyncSubs();
  $id("mSub").value=tx.si>=0?tx.si:0;
  $id("mName").value=tx.name;
  $id("mAmt").value=tx.amt;
  $id("mDate").value=tx.date;
  $id("editModal").classList.add("open");
}

function mSyncSubs(){
  var d=activeData();
  var ci=parseInt($id("mCat").value,10);
  var html=""; for(var i=0;i<d.bd[ci].subs.length;i++) html+='<option value="'+i+'">'+d.bd[ci].subs[i].name+'</option>';
  $id("mSub").innerHTML=html;
}

function closeModal(){ $id("editModal").classList.remove("open"); EDIT_ID=null; }

// --- CLOSED OUT CUT-OFF FUNCTION ---
function saveEdit(){
  var d = activeData();
  var tx = null;
  
  for(var i = 0; i < d.txs.length; i++) {
    if(d.txs[i].id === EDIT_ID) {
      tx = d.txs[i]; 
      break; 
    }
  }
  
  if(!tx) return;
  
  tx.name = $id("mName").value;
  tx.ci = parseInt($id("mCat").value, 10);
  tx.si = parseInt($id("mSub").value, 10);
  tx.amt = parseFloat($id("mAmt").value);
  tx.date = $id("mDate").value;
  
  closeModal();
  if (typeof saveAndRender === 'function') saveAndRender();
}

// --- CORRECTED MATH LOGIC: Visual Display for Remaining Budget ---
function renderUnallocated() {
  if (!STATE || !STATE.activeMonth) return;
  var income = getIncome();
  var d = activeData();
  var box = $id("unallocBox");
  
  if(!box) return;

  // The correct math: Monthly Income - Total Budgeted
  var totalBudgeted = totalAssigned(d.bd);
  var remaining = Math.round((income - totalBudgeted) * 100) / 100;

  if (remaining >= 0) {
    box.className = "unalloc-box ok";
    box.innerHTML = '<div class="unalloc-label">Remaining to Budget</div>' +
                    '<div class="unalloc-amt ok">' + money(remaining) + '</div>' +
                    '<div class="unalloc-hint">Assign this to your subcategories.</div>';
  } else {
    box.className = "unalloc-box over";
    box.innerHTML = '<div class="unalloc-label">Over Budget</div>' +
                    '<div class="unalloc-amt over">' + money(Math.abs(remaining)) + '</div>' +
                    '<div class="unalloc-hint">You\'ve assigned more than you earn!</div>';
  }
}
</script>
</body>
</html>
